# Copy to .env.local. Never commit .env.local or a downloaded service account.
# Firebase web app config (Project settings > General > Your apps).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional reference only; website analytics is currently disabled.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin: server only. Copy from the service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep quotes here and replace newlines with literal \n. Paste the PEM into Vercel.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Razorpay: start with Test Mode keys. Use automatic payment capture.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# A separate random secret chosen while adding the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=

# EmailJS only notifies the owner after a contact message is saved to Firestore.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Gmail SMTP for order confirmation/status emails. Server only.
# Authenticate as this exact mailbox. Use a Google App Password after enabling 2-Step Verification.
SMTP_USER=ucallleather.india@gmail.com
SMTP_PASS=
# 465 uses TLS immediately; 587 requires STARTTLS. Host is fixed to smtp.gmail.com.
SMTP_PORT=465

# Optional existing Resend fallback when SMTP_PASS is absent. Gmail senders are rejected here.
# Verify your own custom sending domain before enabling this fallback.
RESEND_API_KEY=
EMAIL_FROM="UCALL Leather Co. <orders@your-domain.com>"
# Random 32+ character secret protects the daily Vercel email retry job.
CRON_SECRET=

# Local: http://localhost:3000. Production: your real https:// domain, no trailing /.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# After deploying /reset-password, set Firebase Authentication > Templates >
# Password reset > Customize action URL to https://YOUR_DOMAIN/reset-password.
# Add that domain to Authentication > Settings > Authorized domains.
# sendPasswordResetEmail's continue URL alone does not change the email handler.

# Optional AI-first order support. Server-only; never use NEXT_PUBLIC_ for these.
# If unavailable, conversations are sent to the human support inbox automatically.
GROQ_API_KEY=
GROQ_SUPPORT_MODEL=openai/gpt-oss-20b
